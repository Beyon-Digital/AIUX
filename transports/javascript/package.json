{
  "name": "@beyond-digital/aiux-transport-js",
  "version": "0.1.1",
  "description": "Host-side JS transport helpers feeding AIUXEvent batches.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../tools/finalize-js.mjs .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@beyond-digital/aiux-protocol-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "ajv": "8.20.0",
    "typescript": "5.9.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Beyon-Digital/AIUX.git",
    "directory": "transports/javascript"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ]
}
