{
  "name": "@beyondigital/aiux-expo",
  "version": "0.1.0",
  "private": true,
  "description": "Expo SDK 57 bridge — the complete AIUX surface behind one native boundary (plan §10).",
  "keywords": [
    "aiux",
    "expo",
    "expo-module"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare:ios": "bash scripts/prepare-ios.sh"
  },
  "dependencies": {
    "@beyondigital/aiux-core": "workspace:*"
  },
  "peerDependencies": {
    "expo": ">=57.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.86.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
