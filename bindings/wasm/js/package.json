{
  "name": "@beyondigital/aiux-core",
  "version": "0.1.0",
  "private": true,
  "description": "JS session package over the AIUX WASM core — AiuxSession wrapper, streaming EventBuffer, snapshot subscriptions, MockCore.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wasm": "./wasm/aiux_wasm.js",
    "./wasm/aiux_wasm_bg.wasm": "./wasm/aiux_wasm_bg.wasm",
    "./buffer": {
      "types": "./src/buffer.ts",
      "default": "./src/buffer.ts"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:wasm": "node ../scripts/build-wasm.mjs && node ./scripts/copy-wasm.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
