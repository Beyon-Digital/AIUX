{
  "name": "@beyond-digital/aiux-core",
  "version": "0.2.0-rc.1",
  "description": "JS session package over the AIUX WASM core \u2014 AiuxSession wrapper, streaming EventBuffer, snapshot subscriptions, MockCore.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wasm": "./wasm/aiux_wasm.js",
    "./wasm/aiux_wasm_bg.wasm": "./wasm/aiux_wasm_bg.wasm",
    "./buffer": {
      "types": "./dist/buffer.d.ts",
      "default": "./dist/buffer.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "wasm",
    "LICENSES"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../../tools/finalize-js.mjs .",
    "build:wasm": "node ../scripts/build-wasm.mjs && node ./scripts/copy-wasm.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Beyon-Digital/AIUX.git",
    "directory": "bindings/wasm/js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
