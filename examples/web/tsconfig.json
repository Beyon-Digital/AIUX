{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@beyond-digital/aiux-core": ["../../bindings/wasm/js/src/index.ts"],
      "@beyond-digital/aiux-web": ["../../renderers/web/src/index.ts"],
      "@beyond-digital/aiux-web/styles.css": [
        "../../renderers/web/src/styles.css"
      ]
    }
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts"]
}
