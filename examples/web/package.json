{
  "name": "@beyond-digital/aiux-example-web",
  "version": "0.1.1",
  "private": true,
  "description": "AIUX web example \u2014 replays every conformance fixture through the real aiux-wasm core and renders it with @beyond-digital/aiux-web.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @beyond-digital/aiux-core run build:wasm && vite",
    "build": "pnpm --filter @beyond-digital/aiux-core run build:wasm && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@beyond-digital/aiux-core": "workspace:*",
    "@beyond-digital/aiux-web": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  },
  "license": "MIT"
}
