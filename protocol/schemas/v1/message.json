{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "definitions": {
    "AiuxError": {
      "additionalProperties": true,
      "description": "Structured error payload (entity name `error` on the wire).",
      "properties": {
        "code": {
          "description": "Stable machine-readable code.",
          "type": "string"
        },
        "detail": {
          "description": "Additional detail for debugging."
        },
        "message": {
          "description": "Human-readable message.",
          "type": "string"
        },
        "retryable": {
          "description": "Whether the operation may be retried.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "Attachment": {
      "additionalProperties": true,
      "description": "A file/media reference carried by parts or messages.",
      "properties": {
        "id": {
          "description": "Stable identifier.",
          "type": [
            "string",
            "null"
          ]
        },
        "mimeType": {
          "description": "MIME type.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "File name.",
          "type": [
            "string",
            "null"
          ]
        },
        "sizeBytes": {
          "description": "Size in bytes.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "uri": {
          "description": "Resource URI (host-mediated).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Citation": {
      "additionalProperties": true,
      "description": "A source citation.",
      "properties": {
        "id": {
          "description": "Stable identifier.",
          "type": [
            "string",
            "null"
          ]
        },
        "snippet": {
          "description": "Quoted snippet.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Origin identifier (index, tool, document store, ...).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "Source title.",
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
          "description": "Source URI.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MessageRole": {
      "description": "Message author role.",
      "enum": [
        "user",
        "assistant",
        "system",
        "tool"
      ],
      "type": "string"
    },
    "MessageStatus": {
      "description": "Message lifecycle status.",
      "enum": [
        "streaming",
        "complete",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "Part": {
      "description": "A typed part within a message (all 13 protocol part kinds; plan §3). Serialized internally tagged: `{\"type\": \"text\", \"text\": \"...\"}`.",
      "oneOf": [
        {
          "additionalProperties": true,
          "description": "Plain text (supports `text.delta` append).",
          "properties": {
            "id": {
              "description": "Stable part identifier within its message.",
              "type": "string"
            },
            "text": {
              "description": "Text content; `text.delta` events append here.",
              "type": "string"
            },
            "type": {
              "enum": [
                "text"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "text",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "description": "Markdown (supports `text.delta` append).",
          "properties": {
            "id": {
              "description": "Stable part identifier within its message.",
              "type": "string"
            },
            "markdown": {
              "description": "Markdown source; `text.delta` events append here.",
              "type": "string"
            },
            "type": {
              "enum": [
                "markdown"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "markdown",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "description": "Code block.",
          "properties": {
            "code": {
              "description": "Code source.",
              "type": "string"
            },
            "id": {
              "description": "Stable part identifier within its message.",
              "type": "string"
            },
            "language": {
              "description": "Language hint.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "enum": [
                "code"
              ],
              "type": "string"
            }
          },
          "required": [
            "code",
            "id",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "description": "Image attachment.",
          "properties": {
            "attachment": {
              "allOf": [
                {
                  "$ref": "#/definitions/Attachment"
                }
              ],
              "description": "Image attachment."
            },
            "id": {
              "description": "Stable part identifier within its message.",
              "type": "string"
            },
            "type": {
              "enum": [
                "image"
              ],
              "type": "string"
            }
          },
          "required": [
            "attachment",
            "id",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "description": "Generic attachment.",
          "properties": {
            "attachment": {
              "allOf": [
                {
                  "$ref": "#/definitions/Attachment"
                }
              ],
              "description": "Attachment reference."
            },
            "id": {
              "description": "Stable part identifier within its message.",
              "type": "string"
            },
            "type": {
              "enum": [
                "attachment"
              ],
              "type": "string"
            }
          },
          "required": [
            "attachment",
            "id",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "description": "Source citation.",
          "properties": {
            "citation": {
              "allOf": [
                {
                  "$ref": "#/definitions/Citation"
                }
              ],
              "description": "Citation."
            },
            "id": {
              "description": "Stable part identifier within its message.",
              "type": "string"
            },
            "type": {
              "enum": [
                "citation"
              ],
              "type": "string"
            }
          },
          "required": [
            "citation",
            "id",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "description": "Reference to a session-level tool record.",
          "properties": {
            "id": {
              "description": "Stable part identifier within its message.",
              "type": "string"
            },
            "toolId": {
              "description": "Referenced tool id.",
              "type": "string"
            },
            "type": {
              "enum": [
                "tool"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "toolId",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "description": "Reference to a session-level approval record.",
          "properties": {
            "approvalId": {
              "description": "Referenced approval id.",
              "type": "string"
            },
            "id": {
              "description": "Stable part identifier within its message.",
              "type": "string"
            },
            "type": {
              "enum": [
                "approval"
              ],
              "type": "string"
            }
          },
          "required": [
            "approvalId",
            "id",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "description": "Reference to a session-level artifact.",
          "properties": {
            "artifactId": {
              "description": "Referenced artifact id.",
              "type": "string"
            },
            "id": {
              "description": "Stable part identifier within its message.",
              "type": "string"
            },
            "type": {
              "enum": [
                "artifact"
              ],
              "type": "string"
            }
          },
          "required": [
            "artifactId",
            "id",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "description": "Inline status line.",
          "properties": {
            "id": {
              "description": "Stable part identifier within its message.",
              "type": "string"
            },
            "level": {
              "anyOf": [
                {
                  "$ref": "#/definitions/StatusLevel"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Severity level."
            },
            "text": {
              "description": "Status text.",
              "type": "string"
            },
            "type": {
              "enum": [
                "status"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "text",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "description": "Inline progress indicator.",
          "properties": {
            "id": {
              "description": "Stable part identifier within its message.",
              "type": "string"
            },
            "progress": {
              "allOf": [
                {
                  "$ref": "#/definitions/Progress"
                }
              ],
              "description": "Progress value."
            },
            "type": {
              "enum": [
                "progress"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "progress",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "description": "Reference to a session-level surface.",
          "properties": {
            "id": {
              "description": "Stable part identifier within its message.",
              "type": "string"
            },
            "surfaceId": {
              "description": "Referenced surface id.",
              "type": "string"
            },
            "type": {
              "enum": [
                "surface"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "surfaceId",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "description": "Error content.",
          "properties": {
            "error": {
              "allOf": [
                {
                  "$ref": "#/definitions/AiuxError"
                }
              ],
              "description": "The error."
            },
            "id": {
              "description": "Stable part identifier within its message.",
              "type": "string"
            },
            "type": {
              "enum": [
                "error"
              ],
              "type": "string"
            }
          },
          "required": [
            "error",
            "id",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Progress": {
      "additionalProperties": true,
      "description": "Normalized progress value.",
      "properties": {
        "current": {
          "description": "Units complete.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "label": {
          "description": "Progress label.",
          "type": [
            "string",
            "null"
          ]
        },
        "total": {
          "description": "Total units.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "StatusLevel": {
      "description": "Severity for `status` parts.",
      "enum": [
        "info",
        "success",
        "warning",
        "error"
      ],
      "type": "string"
    }
  },
  "description": "A session message composed of typed parts.",
  "properties": {
    "createdAt": {
      "description": "Creation timestamp (ISO-8601, host-supplied).",
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "description": "Stable identifier.",
      "type": "string"
    },
    "metadata": {
      "description": "Free-form host metadata."
    },
    "parts": {
      "description": "Ordered parts.",
      "items": {
        "$ref": "#/definitions/Part"
      },
      "type": "array"
    },
    "role": {
      "allOf": [
        {
          "$ref": "#/definitions/MessageRole"
        }
      ],
      "description": "Author role."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/MessageStatus"
        },
        {
          "type": "null"
        }
      ],
      "description": "Lifecycle status."
    }
  },
  "required": [
    "id",
    "role"
  ],
  "title": "Message",
  "type": "object"
}
