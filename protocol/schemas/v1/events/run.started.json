{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "definitions": {
    "AiuxError": {
      "additionalProperties": true,
      "description": "Structured error payload (entity name `error` on the wire).",
      "properties": {
        "code": {
          "description": "Stable machine-readable code.",
          "type": "string"
        },
        "detail": {
          "description": "Additional detail for debugging."
        },
        "message": {
          "description": "Human-readable message.",
          "type": "string"
        },
        "retryable": {
          "description": "Whether the operation may be retried.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ContextEntity": {
      "additionalProperties": true,
      "description": "A contextual entity injected into the session (file, record, URL, ...).",
      "properties": {
        "data": {
          "description": "Free-form structured data for the host/renderer."
        },
        "description": {
          "description": "Longer description.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Stable identifier.",
          "type": "string"
        },
        "kind": {
          "description": "Semantic kind, e.g. `file`, `issue`, `customer`.",
          "type": "string"
        },
        "label": {
          "description": "Display label.",
          "type": "string"
        },
        "uri": {
          "description": "Link target for the renderer.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "type": "object"
    },
    "Run": {
      "additionalProperties": true,
      "description": "A run: one agent execution span within a session.",
      "properties": {
        "completedAt": {
          "description": "End timestamp (ISO-8601, host-supplied).",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/definitions/AiuxError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Error on failure."
        },
        "id": {
          "description": "Stable identifier.",
          "type": "string"
        },
        "inputMessageId": {
          "description": "Message the run responds to, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "description": "Result on success."
        },
        "retryOf": {
          "description": "Previous run this run retries, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "startedAt": {
          "description": "Start timestamp (ISO-8601, host-supplied).",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "allOf": [
            {
              "$ref": "#/definitions/RunStatus"
            }
          ],
          "description": "Lifecycle status."
        }
      },
      "required": [
        "id",
        "status"
      ],
      "type": "object"
    },
    "RunStarted": {
      "description": "`run.started` — begins an agent execution span.",
      "properties": {
        "context": {
          "description": "Context entities injected with this run.",
          "items": {
            "$ref": "#/definitions/ContextEntity"
          },
          "type": "array"
        },
        "protocolVersion": {
          "default": "0.1",
          "description": "Protocol version carried by the payload.",
          "type": "string"
        },
        "run": {
          "allOf": [
            {
              "$ref": "#/definitions/Run"
            }
          ],
          "description": "The run."
        }
      },
      "required": [
        "run"
      ],
      "type": "object"
    },
    "RunStatus": {
      "description": "Run lifecycle status.",
      "enum": [
        "running",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "description": "The canonical event envelope. `P` defaults to a raw JSON payload for dispatch-time parsing; typed instantiations (`AiuxEvent<SessionCreated>`) are used for schema generation and typed producers.",
  "properties": {
    "eventId": {
      "description": "Unique event identifier — replays of a known id are ignored.",
      "type": "string"
    },
    "payload": {
      "allOf": [
        {
          "$ref": "#/definitions/RunStarted"
        }
      ],
      "description": "Type-specific payload."
    },
    "protocolVersion": {
      "default": "0.1",
      "description": "Protocol version of this event.",
      "type": "string"
    },
    "sequence": {
      "description": "Monotonic sequence within the session (0-based).",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "sessionId": {
      "description": "Owning session.",
      "type": "string"
    },
    "timestamp": {
      "description": "Event timestamp (ISO-8601, host-supplied — never core-generated).",
      "type": "string"
    },
    "type": {
      "description": "Event type, e.g. `session.created`. Unknown values deserialize fine and fail later with `ProtocolError::Unsupported`.",
      "type": "string"
    }
  },
  "required": [
    "eventId",
    "payload",
    "sequence",
    "sessionId",
    "timestamp",
    "type"
  ],
  "title": "AiuxEvent_for_RunStarted",
  "type": "object"
}
