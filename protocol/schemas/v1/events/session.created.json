{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "definitions": {
    "Capability": {
      "additionalProperties": true,
      "description": "A declared session capability (e.g. `tools.execute`, `files.upload`).",
      "properties": {
        "description": {
          "description": "Human-readable description.",
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "default": true,
          "description": "Whether the capability is enabled (default true).",
          "type": "boolean"
        },
        "id": {
          "description": "Capability identifier.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "ContextEntity": {
      "additionalProperties": true,
      "description": "A contextual entity injected into the session (file, record, URL, ...).",
      "properties": {
        "data": {
          "description": "Free-form structured data for the host/renderer."
        },
        "description": {
          "description": "Longer description.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Stable identifier.",
          "type": "string"
        },
        "kind": {
          "description": "Semantic kind, e.g. `file`, `issue`, `customer`.",
          "type": "string"
        },
        "label": {
          "description": "Display label.",
          "type": "string"
        },
        "uri": {
          "description": "Link target for the renderer.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "type": "object"
    },
    "Session": {
      "additionalProperties": true,
      "description": "An AI interaction session.",
      "properties": {
        "capabilities": {
          "description": "Declared capabilities.",
          "items": {
            "$ref": "#/definitions/Capability"
          },
          "type": "array"
        },
        "context": {
          "description": "Context entities bound to the session.",
          "items": {
            "$ref": "#/definitions/ContextEntity"
          },
          "type": "array"
        },
        "createdAt": {
          "description": "Creation timestamp (ISO-8601, supplied by the host).",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Session identifier — matches the event envelope `sessionId`.",
          "type": "string"
        },
        "metadata": {
          "description": "Free-form host metadata."
        },
        "title": {
          "description": "Display title.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "SessionCreated": {
      "description": "`session.created` — establishes session metadata.",
      "properties": {
        "protocolVersion": {
          "default": "0.1",
          "description": "Protocol version carried by the payload.",
          "type": "string"
        },
        "session": {
          "allOf": [
            {
              "$ref": "#/definitions/Session"
            }
          ],
          "description": "The session entity."
        }
      },
      "required": [
        "session"
      ],
      "type": "object"
    }
  },
  "description": "The canonical event envelope. `P` defaults to a raw JSON payload for dispatch-time parsing; typed instantiations (`AiuxEvent<SessionCreated>`) are used for schema generation and typed producers.",
  "properties": {
    "eventId": {
      "description": "Unique event identifier — replays of a known id are ignored.",
      "type": "string"
    },
    "payload": {
      "allOf": [
        {
          "$ref": "#/definitions/SessionCreated"
        }
      ],
      "description": "Type-specific payload."
    },
    "protocolVersion": {
      "default": "0.1",
      "description": "Protocol version of this event.",
      "type": "string"
    },
    "sequence": {
      "description": "Monotonic sequence within the session (0-based).",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "sessionId": {
      "description": "Owning session.",
      "type": "string"
    },
    "timestamp": {
      "description": "Event timestamp (ISO-8601, host-supplied — never core-generated).",
      "type": "string"
    },
    "type": {
      "description": "Event type, e.g. `session.created`. Unknown values deserialize fine and fail later with `ProtocolError::Unsupported`.",
      "type": "string"
    }
  },
  "required": [
    "eventId",
    "payload",
    "sequence",
    "sessionId",
    "timestamp",
    "type"
  ],
  "title": "AiuxEvent_for_SessionCreated",
  "type": "object"
}
