{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "definitions": {
    "AiuxError": {
      "additionalProperties": true,
      "description": "Structured error payload (entity name `error` on the wire).",
      "properties": {
        "code": {
          "description": "Stable machine-readable code.",
          "type": "string"
        },
        "detail": {
          "description": "Additional detail for debugging."
        },
        "message": {
          "description": "Human-readable message.",
          "type": "string"
        },
        "retryable": {
          "description": "Whether the operation may be retried.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "Progress": {
      "additionalProperties": true,
      "description": "Normalized progress value.",
      "properties": {
        "current": {
          "description": "Units complete.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "label": {
          "description": "Progress label.",
          "type": [
            "string",
            "null"
          ]
        },
        "total": {
          "description": "Total units.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Tool": {
      "additionalProperties": true,
      "description": "A tool invocation tracked by the session.",
      "properties": {
        "completedAt": {
          "description": "Completion timestamp (ISO-8601, host-supplied).",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/definitions/AiuxError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Error on failure."
        },
        "id": {
          "description": "Stable identifier.",
          "type": "string"
        },
        "input": {
          "description": "Invocation input."
        },
        "name": {
          "description": "Tool name.",
          "type": "string"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/definitions/Progress"
            },
            {
              "type": "null"
            }
          ],
          "description": "Latest progress."
        },
        "result": {
          "description": "Result on success."
        },
        "startedAt": {
          "description": "Start timestamp (ISO-8601, host-supplied).",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "allOf": [
            {
              "$ref": "#/definitions/ToolStatus"
            }
          ],
          "description": "Lifecycle status."
        }
      },
      "required": [
        "id",
        "name",
        "status"
      ],
      "type": "object"
    },
    "ToolStarted": {
      "description": "`tool.started`.",
      "properties": {
        "protocolVersion": {
          "default": "0.1",
          "description": "Protocol version carried by the payload.",
          "type": "string"
        },
        "tool": {
          "allOf": [
            {
              "$ref": "#/definitions/Tool"
            }
          ],
          "description": "The tool invocation."
        }
      },
      "required": [
        "tool"
      ],
      "type": "object"
    },
    "ToolStatus": {
      "description": "Tool lifecycle status.",
      "enum": [
        "running",
        "completed",
        "failed"
      ],
      "type": "string"
    }
  },
  "description": "The canonical event envelope. `P` defaults to a raw JSON payload for dispatch-time parsing; typed instantiations (`AiuxEvent<SessionCreated>`) are used for schema generation and typed producers.",
  "properties": {
    "eventId": {
      "description": "Unique event identifier — replays of a known id are ignored.",
      "type": "string"
    },
    "payload": {
      "allOf": [
        {
          "$ref": "#/definitions/ToolStarted"
        }
      ],
      "description": "Type-specific payload."
    },
    "protocolVersion": {
      "default": "0.1",
      "description": "Protocol version of this event.",
      "type": "string"
    },
    "sequence": {
      "description": "Monotonic sequence within the session (0-based).",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "sessionId": {
      "description": "Owning session.",
      "type": "string"
    },
    "timestamp": {
      "description": "Event timestamp (ISO-8601, host-supplied — never core-generated).",
      "type": "string"
    },
    "type": {
      "description": "Event type, e.g. `session.created`. Unknown values deserialize fine and fail later with `ProtocolError::Unsupported`.",
      "type": "string"
    }
  },
  "required": [
    "eventId",
    "payload",
    "sequence",
    "sessionId",
    "timestamp",
    "type"
  ],
  "title": "AiuxEvent_for_ToolStarted",
  "type": "object"
}
