{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "A source citation.",
  "properties": {
    "id": {
      "description": "Stable identifier.",
      "type": [
        "string",
        "null"
      ]
    },
    "snippet": {
      "description": "Quoted snippet.",
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "description": "Origin identifier (index, tool, document store, ...).",
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "description": "Source title.",
      "type": [
        "string",
        "null"
      ]
    },
    "uri": {
      "description": "Source URI.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "Citation",
  "type": "object"
}
